{
  "name": "@mnmal-ai/cortext-omp",
  "version": "1.0.0-alpha.21",
  "description": "Cortext — the OMP (oh-my-pi) skin: cold-start and inbox seams as an OMP extension, bundling the @mnmal-ai/synoptic host into a committed dist artifact.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnmal-ai/synoptic.git",
    "directory": "packages/cortext-omp"
  },
  "type": "module",
  "omp": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@mnmal-ai/synoptic": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
