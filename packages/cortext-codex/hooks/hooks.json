{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/cortext.mjs\"",
            "timeout": 12,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading Cortext context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/cortext.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Cortext inbox"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/cortext.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking Cortext inbox"
          }
        ]
      }
    ]
  }
}
