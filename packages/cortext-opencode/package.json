    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@mnmal-ai/synoptic": "workspace:*",
    "@opencode-ai/plugin": "catalog:",
    "@opencode/plugin": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.2.0"
  }
}
