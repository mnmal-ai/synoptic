{
  "name": "@mnmal-ai/cortext-plugin",
  "version": "1.0.0-alpha.3",
  "private": true,
  "description": "Cortext — the Claude Code skin: synoptic cold-start + inbox seams + /substrate-setup onboarding, bundling the @mnmal-ai/synoptic host into committed hook artifacts. Distributed via the mnmal-ai marketplace, not npm.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnmal-ai/synoptic.git",
    "directory": "packages/cortext-plugin"
  },
  "type": "module",
  "bin": {
    "synoptic-onboard": "bin/onboard.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "sync-version": "node scripts/sync-fragment-version.mjs",
    "version": "node scripts/sync-fragment-version.mjs && git add fragments/substrate-conventions.md .claude-plugin/plugin.json ../cortext-opencode/instructions/substrate-conventions.md ../../.claude-plugin/marketplace.json",
    "clean": "rm -rf hooks/*.mjs"
  },
  "devDependencies": {
    "@mnmal-ai/synoptic": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.2.0"
  }
}
