{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/hooks/*.mjs",
      "!**/bin/resolve-fragment.mjs",
      "!**/bin/audit.mjs",
      "!**/bin/prune-cache.mjs",
      "!**/bin/onboard.mjs",
      "!**/bin/substrate-mcp.mjs",
      "!**/*.tsbuildinfo",
      "!**/config.schema.json",
      "!**/release-surface.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "none",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "performance": {
            "noDynamicNamespaceImportAccess": "off"
          }
        }
      }
    }
  ]
}
